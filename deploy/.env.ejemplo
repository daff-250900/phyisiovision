# Copia este archivo a deploy/.env y rellénalo. Ese archivo NO se versiona.

# --- acceso ---------------------------------------------------------------- #
# Dominio público, o `localhost` para una prueba en el propio equipo.
DOMINIO=localhost
ACME_EMAIL=

# Usuarios de la aplicación: una línea `usuario:pbkdf2_sha256$...` por persona,
# separadas por comas. Se generan con:  python -m src.auth <usuario>
# Aquí va el RESUMEN, nunca la contraseña.
PHYSIOVISION_USUARIOS=

# --- servicios opcionales --------------------------------------------------- #
# Sin esto, los textos salen de knowledge_base/ejercicios.json.
GEMINI_API_KEY=

# La voz necesita además deploy/secretos/google.json (cuenta de servicio).
PHYSIOVISION_TTS_MOTOR=auto

# --- puertos del proxy ------------------------------------------------------ #
PUERTO_HTTP=80
PUERTO_HTTPS=443
