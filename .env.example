# Copia este archivo a .env y rellena los valores que necesites.
# .env está en .gitignore: nunca subas credenciales al repositorio.
#
# Este archivo SÍ se versiona: es la plantilla. Las variables sensibles van
# siempre vacías. Para que git te avise si se cuela un valor, activa el hook:
#
#     git config core.hooksPath .githooks

# --- Redacción de la realimentación con Google Gemini (opcional) -------------
# Sin esta clave la app funciona igual, usando los textos de
# knowledge_base/ejercicios.json. Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo y tiempo máximo de espera. La API rechaza valores por debajo de 10 s
# (400 INVALID_ARGUMENT); el código fuerza ese mínimo aunque pongas menos.
PHYSIOVISION_GEMINI_MODELO=gemini-flash-lite-latest
PHYSIOVISION_GEMINI_TIMEOUT=12
# Intentos por mensaje. Cuando el servicio falla no lo hace rápido: agota el
# plazo. Tras 3 fallos seguidos se deja de llamar durante 60 s.
PHYSIOVISION_GEMINI_INTENTOS=2

# --- Voz de las consignas (opcional) -----------------------------------------
# Dos motores. "auto" usa Cloud TTS si hay credenciales y si no cae a la API de
# Gemini, que funciona con la GEMINI_API_KEY de arriba y NO necesita ninguna
# alta extra. Ese es el camino rápido.
PHYSIOVISION_TTS_MOTOR=auto

# Motor gemini: voces en https://ai.google.dev/gemini-api/docs/speech-generation
# Ojo con la cuota del nivel gratuito: 3 peticiones por minuto para el modelo de
# voz, asi que el precalentado de las diez consignas tarda unos minutos.
PHYSIOVISION_TTS_MODELO_GEMINI=gemini-2.5-flash-preview-tts
PHYSIOVISION_TTS_VOZ_GEMINI=Kore

# Motor cloud: NO acepta claves de API (devuelve 401 UNAUTHENTICATED). Hace falta
# una cuenta de servicio: en la consola de Google Cloud habilita "Cloud
# Text-to-Speech API", crea la cuenta, descarga su JSON y pon aquí la ruta.
GOOGLE_APPLICATION_CREDENTIALS=

# es-US para español latinoamericano, es-ES para peninsular. Voz concreta en
# https://cloud.google.com/text-to-speech/docs/voices (vacío = la elige Google).
PHYSIOVISION_TTS_IDIOMA=es-US
PHYSIOVISION_TTS_VOZ=
# Algo por encima del natural: son consignas breves entre repeticiones.
PHYSIOVISION_TTS_VELOCIDAD=1.05

# --- Servidor ----------------------------------------------------------------
# 127.0.0.1 en local. En contenedor hace falta 0.0.0.0, pero ten en cuenta que
# expone la cámara y el historial de pacientes a la red.
PHYSIOVISION_HOST=127.0.0.1
PHYSIOVISION_PORT=7860

# --- MediaPipe ---------------------------------------------------------------
# DEBE coincidir con la variante usada al entrenar (ver models/feature_contract.json).
# Cambiarla desplaza los ángulos ~13 grados y rompe el contrato del modelo.
PHYSIOVISION_MEDIAPIPE=heavy
